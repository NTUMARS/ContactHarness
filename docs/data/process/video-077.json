{"summaryEvents": [{"mediaTime": 0, "sourceTime": -41.84, "kind": "summary", "type": "summary", "text": "The agent checks the camera views to locate the cube and basket.", "sourceEventIndex": 1, "sourceTextSha256": "fd72801f7b74d977bc42aaa8dabcdd60fcebfce3d13ae5332a1a44b6f1b950cf"}, {"mediaTime": 0, "sourceTime": -18.69, "kind": "summary", "type": "summary", "text": "The gripper is open and clear. The agent plans to align above the cube and check the grasp.", "sourceEventIndex": 6, "sourceTextSha256": "3dc61a0d72b5d97c47bc20aba236aa0b2e44751bf97932b5967edc59c01e437e"}, {"mediaTime": 48.74, "sourceTime": 48.74, "kind": "summary", "type": "summary", "text": "The side view shows an offset. The agent corrects it before closing the fingers.", "sourceEventIndex": 15, "sourceTextSha256": "396adf37466af674b407998ac1f648f2f61596e6ddd8f31ebb3b3ded636eeed8"}, {"mediaTime": 95.74, "sourceTime": 95.74, "kind": "summary", "type": "summary", "text": "The cube is grasped and lifted clear. The agent moves it over the basket before release.", "sourceEventIndex": 28, "sourceTextSha256": "8bfbb568d6c234be1b9e165086efe63c51eac15958a687383c998cde4004923c"}, {"mediaTime": 191.08, "sourceTime": 191.08, "kind": "summary", "type": "summary", "text": "Both camera views confirm the cube remains in the basket after release.", "sourceEventIndex": 45, "sourceTextSha256": "446e603ad83dbfa365949b42bc2dbd2412c4eb36d0c32b4686f7b2111c91766b"}]}