{"summaryEvents": [{"mediaTime": 0.37, "sourceTime": 0.37, "kind": "summary", "type": "summary", "text": "The plug is clear of the rail-mounted socket and the sensors are calibrated.", "sourceEventIndex": 1, "sourceTextSha256": "edfb66ef38c726a5e4e9bb27c3e58e27e63b0ff379509f1948f0c362ea477cea"}, {"mediaTime": 73.19, "sourceTime": 73.19, "kind": "summary", "type": "summary", "text": "Resistance indicates contact, but a visible gap still requires centering.", "sourceEventIndex": 13, "sourceTextSha256": "545c06ede0cc20152a7c886c67d3fed4134129c7ac3419266bd81f6634a42b0e"}, {"mediaTime": 105.46, "sourceTime": 105.46, "kind": "summary", "type": "summary", "text": "The camera views confirm entry without a visible gap.", "sourceEventIndex": 20, "sourceTextSha256": "232e42722da833ecc999fe5320b558603ca982c7c0b43fa3f0254785b03a72c8"}, {"mediaTime": 167.2, "sourceTime": 167.2, "kind": "summary", "type": "summary", "text": "The plug advances, and reversing the trial rotation reduces bending load.", "sourceEventIndex": 33, "sourceTextSha256": "acde1aaf7226249508359121d8e5a09d6384be8d959fef655129e5d831f40bc3"}]}