{"summaryEvents": [{"mediaTime": 0, "sourceTime": -3.5, "kind": "summary", "type": "summary", "text": "The plug is below the left socket, and the agent begins the approach.", "sourceEventIndex": 1, "sourceTextSha256": "f819ea64592565c7fca3a7e4ba9e750e556f7e2993fdca5c7f6feac769b843dc"}, {"mediaTime": 73.78, "sourceTime": 73.78, "kind": "summary", "type": "summary", "text": "Wrist views and force confirm housing contact. The agent slides toward the opening.", "sourceEventIndex": 12, "sourceTextSha256": "8bccdef7642fcdf4ae569835f40e2415b4b86ca323f2cdf737d68f44105072f4"}, {"mediaTime": 144.09, "sourceTime": 144.09, "kind": "summary", "type": "summary", "text": "After insertion begins, a rotation increases bending and needs to be reversed.", "sourceEventIndex": 23, "sourceTextSha256": "14daff6d2f4bf47e109ba630567917fc0d6acdbf971162f4af3f2a29e9c19249"}, {"mediaTime": 227.62, "sourceTime": 227.62, "kind": "summary", "type": "summary", "text": "The plug has advanced with little lateral force. The bounded adjustment sequence is complete.", "sourceEventIndex": 36, "sourceTextSha256": "39db0a5c2b1553424be0f6d0c5ffb7dad6afa775738d1b39b6e06d87a128b80e"}]}