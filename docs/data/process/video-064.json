{"summaryEvents": [{"mediaTime": 0, "sourceTime": -0.28, "kind": "summary", "type": "summary", "text": "The agent uses the side view to check the height of the narrow socket.", "sourceEventIndex": 1, "sourceTextSha256": "24b319d441cff5e5ab2c6512cf9fcc4280e722307dfe7e9bf7879ab81dc79f3e"}, {"mediaTime": 64.62, "sourceTime": 64.62, "kind": "summary", "type": "summary", "text": "The tip is off-center and contact is uncertain. The agent withdraws and corrects the height.", "sourceEventIndex": 9, "sourceTextSha256": "f6d061d4ef8c369ad8e09e3c3d774279b9707609218e159c518627b3393049ee"}, {"mediaTime": 144.45, "sourceTime": 144.45, "kind": "summary", "type": "summary", "text": "Resistance indicates face contact, but a wrist-view gap requires further correction.", "sourceEventIndex": 22, "sourceTextSha256": "60853205e823a1758c53647d9e49a9d57de468b75e2e49bc0f42313b3b6bbf52"}, {"mediaTime": 199.9, "sourceTime": 199.9, "kind": "summary", "type": "summary", "text": "Both wrist views confirm entry without a visible gap.", "sourceEventIndex": 33, "sourceTextSha256": "30cc420afe27835af7ee2232c831db55bb63fdd9ecd992985368dbe123d961b4"}, {"mediaTime": 264.13, "sourceTime": 264.13, "kind": "summary", "type": "summary", "text": "The plug advances with little lateral load, but tactile bending still needs correction.", "sourceEventIndex": 44, "sourceTextSha256": "928961533b0aca1a842f18e5c4401ca9afdfdc2a81cfc0f2831f492afe35d318"}]}